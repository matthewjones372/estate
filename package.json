{
  "name": "estate",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "dependency-cruiser": "^18.5.0",
    "knip": "^6.39.0",
    "typescript": "^6"
  },
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "unused": "knip",
    "layers": "depcruise . --config .dependency-cruiser.cjs",
    "slop": "bun tools/slop.ts",
    "test": "bun test --coverage",
    "gate": "bun tools/gate.ts"
  },
  "type": "module"
}
