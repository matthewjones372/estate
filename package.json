{
  "name": "estate",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7",
    "@babel/preset-typescript": "^7",
    "@biomejs/biome": "^2.6.3",
    "@happy-dom/global-registrator": "^21.0.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "@swc/core": "^1.16.20",
    "@types/babel__core": "^7",
    "@types/bun": "^1.4.4",
    "babel-preset-solid": "^1.9.16",
    "dependency-cruiser": "^18.7.0",
    "knip": "^6.43.0",
    "solid-js": "^1.9.17",
    "testcontainers": "^12.2.1",
    "typescript": "^7"
  },
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "unused": "knip",
    "layers": "depcruise . --config .dependency-cruiser.cjs",
    "slop": "bun tools/slop.ts",
    "test": "bun test --coverage",
    "gate": "bun tools/gate.ts",
    "perf": "bun bench/run.ts 50 5 --check",
    "integration": "bun test --timeout 300000 ./integration/*.it.ts"
  },
  "type": "module",
  "dependencies": {
    "@effect/platform-bun": "4.0.7",
    "@effect/sql-pg": "4.0.7",
    "effect": "4.0.7",
    "fflate": "0.8.3",
    "jose": "^6.2.13"
  }
}
